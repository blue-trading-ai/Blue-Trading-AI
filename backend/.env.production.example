# ============================================================
# BLUE TRADING AI / MARKETMIND.AI
# VERSION 49 - PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================
#
# IMPORTANT:
# - Preferred production setup: configure these values as deployment-platform
#   environment variables / secrets.
# - If using a file-based deployment with the current app/core/config.py,
#   copy this template to `.env` because Settings currently loads `.env`.
# - `.env.production` is NOT automatically loaded by current config.py.
# - Never commit real secrets.
# - Replace every CHANGE_ME value before deployment.
# ============================================================

# ------------------------------------------------------------
# APPLICATION / CORE SETTINGS
# ------------------------------------------------------------

APP_NAME=Blue Trading AI
ENVIRONMENT=production
APP_VERSION=49.0.0
DEBUG=false

EXPOSE_DEVELOPMENT_TOKENS=false

OWNER_EMAIL=CHANGE_ME_OWNER_EMAIL
OWNER_APPROVAL_REQUIRED=true

PLANS_ENABLED=false
SUBSCRIPTIONS_ENABLED=false
PAYMENTS_ENABLED=false

# Public deployment URLs used by validation and deployed clients.
BACKEND_URL=https://api.example.com
FRONTEND_URL=https://example.com

# ------------------------------------------------------------
# CORE SECURITY
# ------------------------------------------------------------

SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_48_CHARACTERS

# Current app/core/config.py expects ALGORITHM.
ALGORITHM=HS256

# Required by production validation in app/core/config.py.
TWELVE_DATA_API_KEY=CHANGE_ME_TWELVE_DATA_API_KEY

LOG_IP_HASH_SALT=CHANGE_ME_GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
ALLOW_INSECURE_PRODUCTION=false

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

# Example:
# DATABASE_URL=postgresql+psycopg://username:password@host:5432/database
# SQLite is not accepted for production.
DATABASE_URL=CHANGE_ME_PRODUCTION_DATABASE_URL

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true

# ------------------------------------------------------------
# JWT AND AUTHENTICATION
# ------------------------------------------------------------

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

JWT_ISSUER=blue-trading-ai
JWT_AUDIENCE=blue-trading-ai-users

PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

REQUIRE_EMAIL_VERIFICATION=true
ALLOW_PUBLIC_REGISTRATION=true

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

CORS_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOW_CREDENTIALS=true

# ------------------------------------------------------------
# SMTP EMAIL
# ------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

EMAIL_FROM_ADDRESS=CHANGE_ME_FROM_ADDRESS
EMAIL_FROM_NAME=Blue Trading AI

# ------------------------------------------------------------
# SIGNAL SAFETY RULES
# ------------------------------------------------------------

MINIMUM_SIGNAL_CONFIDENCE=80
MINIMUM_SIGNAL_CONFIRMATIONS=3
MINIMUM_SIGNAL_RISK_REWARD=1.5

LEARNING_MINIMUM_COMPLETED_TRADES=20
LEARNING_USES_COMPLETED_TRADES_ONLY=true

BROKER_EXECUTION_ENABLED=false

# ------------------------------------------------------------
# BACKGROUND PROCESSING
# ------------------------------------------------------------

BACKGROUND_WORKER_ENABLED=true
BACKGROUND_WORKER_NAME=production-worker-1
BACKGROUND_POLL_INTERVAL_SECONDS=2
BACKGROUND_HEARTBEAT_INTERVAL_SECONDS=15
BACKGROUND_STALLED_AFTER_SECONDS=300
BACKGROUND_DEFAULT_RETRY_DELAY_SECONDS=60
BACKGROUND_MAX_ATTEMPTS=3

# ------------------------------------------------------------
# LOGGING AND MONITORING
# ------------------------------------------------------------

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_RETENTION_DAYS=30
SLOW_REQUEST_THRESHOLD_MS=1000
MONITORING_ENABLED=true
REQUEST_BODY_LOGGING_ENABLED=false
AUTHORIZATION_HEADER_LOGGING_ENABLED=false
COOKIE_HEADER_LOGGING_ENABLED=false

# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------
# SERVER / PROXY
# ------------------------------------------------------------

HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1
TRUST_PROXY_HEADERS=true
FORWARDED_ALLOW_IPS=127.0.0.1

# ------------------------------------------------------------
# DEPLOYMENT SAFETY CHECKLIST
# ------------------------------------------------------------
#
# 1. Replace every CHANGE_ME value.
# 2. Set ENVIRONMENT=production.
# 3. Keep DEBUG=false.
# 4. Keep EXPOSE_DEVELOPMENT_TOKENS=false.
# 5. Keep OWNER_APPROVAL_REQUIRED=true.
# 6. Keep PLANS_ENABLED=false.
# 7. Keep SUBSCRIPTIONS_ENABLED=false.
# 8. Keep PAYMENTS_ENABLED=false.
# 9. Keep BROKER_EXECUTION_ENABLED=false.
# 10. Configure a production PostgreSQL database.
# 11. Configure TWELVE_DATA_API_KEY.
# 12. Configure exact HTTPS CORS origins.
# 13. Configure BACKEND_URL and FRONTEND_URL.
# 14. Configure SMTP securely.
# 15. Run: alembic upgrade head
# 16. Confirm: alembic current
#     -> v46_application_event_logs (head)
# 17. Run: python -m pytest -q
# 18. Run readiness/deployment validation.
# 19. Never commit real production secrets.
# 20. Use HTTPS in production.
